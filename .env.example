# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nexora?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"

# Encryption (for OAuth tokens)
ENCRYPTION_MASTER_KEY="your-32-char-master-key-for-encryption"
ENCRYPTION_SALT="your-salt-for-key-derivation"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AI Providers (choose one or both)
AI_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Optional: Email for password reset
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="user"
EMAIL_SERVER_PASSWORD="password"
EMAIL_FROM="noreply@nexora.app"